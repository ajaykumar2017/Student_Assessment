<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="330dp"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/select_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="Select Subject"
        android:textColor="@color/verydarkgrey"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@layout/rounded_border_edittext"
        android:maxLines="1"
        android:hint="Enter your new name..."
        android:paddingStart="10dp" />

    <RadioGroup
        android:id="@+id/radioGroup_gender"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@layout/rounded_border_edittext"
        android:layout_marginBottom="20dp"
        android:paddingStart="20dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rad_male"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:buttonTint="@color/verydarkgrey"
            android:text="Male" />

        <RadioButton
            android:id="@+id/rad_female"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:buttonTint="@color/verydarkgrey"
            android:text="Female" />

        <RadioButton
            android:id="@+id/rad_others"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:buttonTint="@color/verydarkgrey"
            android:text="Others" />
    </RadioGroup>

    <Spinner
        android:id="@+id/sp_branch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@layout/rounded_border_edittext"
        android:entries="@array/branches" />

    <Spinner
        android:id="@+id/sp_semester"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@layout/rounded_border_edittext"
        android:entries="@array/semester" />

    <Spinner
        android:id="@+id/sp_college"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@layout/rounded_border_edittext"
        android:entries="@array/collegelist" />

    <Spinner
        android:id="@+id/sp_university"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@layout/rounded_border_edittext"
        android:entries="@array/university" />
    <Button
        android:id="@+id/btn_submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/colorPrimary"
        android:text="SUBMIT"
        android:textColor="@color/white"
        android:textStyle="bold"/>

</LinearLayout>