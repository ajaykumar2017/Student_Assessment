<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tecent.student_assessment">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ui.activity.DiscussionForumActivity"
            android:theme="@style/AppThemeDiscussionForum"
            android:windowSoftInputMode="stateVisible|adjustResize"/>
        <activity android:name="com.tecent.student_assessment.ui.activity.ForgetPasswordActivity" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.ContactUsActivity"
            android:theme="@style/AppThemeContactUs"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.ChangePasswordActivity"
            android:theme="@style/AppThemeChangePassword" />
        <activity android:name=".ui.activity.ImageViewerActivity" />
        <activity android:name="com.tecent.student_assessment.ui.activity.SearchActivity" />
        <activity
            android:name=".ui.activity.DashBoardMenuWebViewActivity"
            android:theme="@style/AppThemeDashboardWebview" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.SinglePostsActivity"
            android:theme="@style/AppThemeProfile" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.AnswersDoubtsPostsDoubtsActivity"
            android:theme="@style/AppThemeAnswersDoubtPost" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.ProfileActivity"
            android:theme="@style/AppThemeProfile" />
        <activity
            android:name=".ui.activity.CommentsPostHomeActivity"
            android:theme="@style/AppThemeCommentPost" />
        <activity
            android:name=".ui.activity.ShowResultFromDashboardActivity"
            android:theme="@style/AppThemeShowResult" />
        <activity android:name=".ui.activity.TestSubjectWebViewActivity" />
        <activity android:name=".ui.activity.TestSeriesSubjectActivity" />
        <activity android:name=".ui.activity.ImagePdfWebViewActivity" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.CreatePostHomeActivity"
            android:theme="@style/AppThemeWithChip" />
        <activity android:name=".ui.activity.SettingsActivity" />
        <activity
            android:name="com.tecent.student_assessment.ui.activity.CreatePostQueryDoubtsActivity"
            android:theme="@style/AppThemeCreatePostQueryDoubts"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".ui.activity.SetUpActivity" />
        <activity android:name=".ui.activity.StudentRegistrationActivity" />
        <activity android:name=".ui.activity.StudentLoginActivity" />
        <activity android:name=".ui.activity.StartScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <data
                    android:host="sas.a3creators.co.in"
                    android:pathPrefix="/StudentAssessment/post"
                    android:scheme="http" />
                <data
                    android:host="sas.a3creators.co.in"
                    android:pathPrefix="/StudentAssessment/post"
                    android:scheme="https" />
                <data
                    android:host="www.sas.a3creators.co.in"
                    android:pathPrefix="/StudentAssessment/post"
                    android:scheme="http" />
                <data
                    android:host="www.sas.a3creators.co.in"
                    android:pathPrefix="/StudentAssessment/post"
                    android:scheme="https" />

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tecent.student_assessment.ui.activity.HomeActivity"
            android:theme="@style/AppThemeNoActionBarHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.theartofdev.edmodo.cropper.CropImageActivity"
            android:theme="@style/Base.Theme.AppCompat" />
    </application>

</manifest>